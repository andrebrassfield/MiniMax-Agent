+# ---------------------------------------------------------------------------
+# params interpolation (${var} substitution into title + body)
+# ---------------------------------------------------------------------------
+
+
+def test_create_task_params_interpolates_title_and_body(kanban_home):
+    """params={...} applies ${var} substitution to title and body
+    before the row is inserted, so the persisted form is the resolved
+    form (not the template)."""
+    with kb.connect() as conn:
+        tid = kb.create_task(
+            conn,
+            title="Analyze ${dataset} for ${audience}",
+            body="Audience tier: ${audience}\nDataset: ${dataset}",
+            params={"dataset": "nwa_ok_route_telemetry_Q2.csv", "audience": "internal"},
+        )
+        t = kb.get_task(conn, tid)
+    assert t is not None
+    assert t.title == "Analyze nwa_ok_route_telemetry_Q2.csv for internal"
+    assert t.body == "Audience tier: internal\nDataset: nwa_ok_route_telemetry_Q2.csv"
+
+
+def test_create_task_params_interpolates_title_only_when_body_none(kanban_home):
+    """Body=None + params should not crash; title interpolates, body stays None."""
+    with kb.connect() as conn:
+        tid = kb.create_task(
+            conn,
+            title="Run on ${dataset}",
+            body=None,
+            params={"dataset": "Q2.csv"},
+        )
+        t = kb.get_task(conn, tid)
+    assert t is not None
+    assert t.title == "Run on Q2.csv"
+    assert t.body is None
+
+
+def test_create_task_params_no_placeholders_is_noop(kanban_home):
+    """params={...} with no ${var} in title/body is a valid no-op."""
+    with kb.connect() as conn:
+        tid = kb.create_task(
+            conn,
+            title="static title",
+            body="static body",
+            params={"unused": "value"},
+        )
+        t = kb.get_task(conn, tid)
+    assert t is not None
+    assert t.title == "static title"
+    assert t.body == "static body"
+
+
+def test_create_task_params_missing_key_raises(kanban_home):
+    """Strict substitution: a ${var} in body that isn't in params
+    must raise ValueError, not silently leave the placeholder literal."""
+    with kb.connect() as conn, pytest.raises(ValueError, match="params interpolation failed"):
+        kb.create_task(
+            conn,
+            title="x",
+            body="Audience: ${audience}",
+            params={"dataset": "Q2.csv"},  # 'audience' missing
+        )
+
+
+def test_create_task_params_none_is_backward_compatible(kanban_home):
+    """params=None (the default) must NOT change behaviour for any
+    existing caller that doesn't know about it."""
+    with kb.connect() as conn:
+        tid = kb.create_task(
+            conn,
+            title="Static ${literal} in body",
+            body="Audience: ${literal} dollar sign $$",
+        )
+        t = kb.get_task(conn, tid)
+    assert t is not None
+    # Template didn't run, so ${literal} stays literal in the body.
