@@ -0,0 +1,178 @@
+"""Tests for agent.langgraph.middleware."""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent.langgraph.middleware import HermesMiddleware, MiddlewareRegistry
+
+
+# ---------------------------------------------------------------------------
+# HermesMiddleware
+# ---------------------------------------------------------------------------
+
+class TestHermesMiddleware:
+    def test_before_node_returns_state(self) -> None:
+        mw = HermesMiddleware()
+        state = {"foo": "bar"}
+        assert mw.before_node("node_a", state) == state
+
+    def test_after_node_returns_state(self) -> None:
+        mw = HermesMiddleware()
+        state = {"foo": "bar"}
+        assert mw.after_node("node_a", state) == state
+
+    def test_before_graph_returns_state(self) -> None:
+        mw = HermesMiddleware()
+        state = {"foo": "bar"}
+        assert mw.before_graph(state) == state
+
+    def test_after_graph_returns_state(self) -> None:
+        mw = HermesMiddleware()
+        state = {"foo": "bar"}
+        assert mw.after_graph(state) == state
+
+
+# ---------------------------------------------------------------------------
+# MiddlewareRegistry
+# ---------------------------------------------------------------------------
+
+class TestMiddlewareRegistry:
+    def test_before_agent_decorator(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.before_agent
+        def add_flag(state: dict[str, Any]) -> dict[str, Any]:
+            state["flag"] = True
+            return state
+
+        assert len(registry._before_agent) == 1
+
+    def test_wrap_model_call_decorator(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.wrap_model_call
+        def track_model(state: dict[str, Any], model_name: str, usage: Any) -> dict[str, Any]:
+            state["model"] = model_name
+            return state
+
+        assert len(registry._wrap_model_call) == 1
+
+    def test_before_tools_decorator(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.before_tools
+        def log_tool(state: dict[str, Any], tool_name: str, tool_args: Any) -> dict[str, Any]:
+            state["last_tool"] = tool_name
+            return state
+
+        assert len(registry._before_tools) == 1
+
+    def test_after_tools_decorator(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.after_tools
+        def record_result(
+            state: dict[str, Any],
+            tool_name: str,
+            tool_args: Any,
+            tool_result: Any,
+        ) -> dict[str, Any]:
+            state["last_result"] = tool_result
+            return state
+
+        assert len(registry._after_tools) == 1
+
+    def test_wrap_node_applies_before_agent(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.before_agent
+        def add_flag(state: dict[str, Any]) -> dict[str, Any]:
+            state["flag"] = True
+            return state
+
+        def _node(state: dict[str, Any]) -> dict[str, Any]:
+            # Realistic node: returns the (possibly modified) state
+            return state
+
+        wrapped = registry.wrap_node("test_node", _node)
+        result = wrapped({})
+        assert result["flag"] is True
+
+    def test_wrap_node_applies_after_tools(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.after_tools
+        def record_result(
+            state: dict[str, Any],
+            tool_name: str,
+            tool_args: Any,
+            tool_result: Any,
+        ) -> dict[str, Any]:
+            state["after"] = True
+            return state
+
+        def _node(state: dict[str, Any]) -> dict[str, Any]:
+            return {"original": "value"}
+
+        wrapped = registry.wrap_node("test_node", _node)
+        result = wrapped({})
+        assert result["after"] is True
+
+    def test_apply_to_graph(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.before_agent
+        def add_flag(state: dict[str, Any]) -> dict[str, Any]:
+            state["flag"] = True
+            return state
+
+        builder = MagicMock()
+        original_a = MagicMock()
+        original_b = MagicMock()
+        node_a = MagicMock(bound=original_a)
+        node_b = MagicMock(bound=original_b)
+        builder.nodes = {"node_a": node_a, "node_b": node_b}
+
+        registry.apply_to_graph(builder)
+
+        # Both nodes should have been wrapped with new callables
+        assert callable(node_a.bound)
+        assert callable(node_b.bound)
+        assert node_a.bound is not original_a
+        assert node_b.bound is not original_b
+
+    def test_wrap_model_call_fn(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.wrap_model_call
+        def track_model(state: dict[str, Any], model_name: str, usage: Any) -> dict[str, Any]:
+            state["model"] = model_name
+            return state
+
+        def _model_fn(state: dict[str, Any], model_name: str, usage: Any) -> dict[str, Any]:
+            # Realistic model call: returns the (possibly modified) state
+            return state
+
+        wrapped = registry.wrap_model_call_fn(_model_fn)
+        result = wrapped({}, "gpt-4o", None)
+        assert result["model"] == "gpt-4o"
+
+    def test_wrap_tool_call_fn(self) -> None:
+        registry = MiddlewareRegistry()
+
+        @registry.before_tools
+        def log_tool(state: dict[str, Any], tool_name: str, tool_args: Any) -> dict[str, Any]:
+            state["last_tool"] = tool_name
+            return state
+
+        def _tool_fn(state: dict[str, Any]) -> str:
+            return "tool_result"
+
+        wrapped = registry.wrap_tool_call_fn(_tool_fn, "test_tool")
+        result = wrapped(state={"x": 1})
+        assert result == "tool_result"
+
