+class MiddlewareRegistry:
+    """Decorator-based hook registry for LangGraph nodes.
+
+    Register hooks with ``@registry.before_agent``, ``@registry.wrap_model_call``,
+    ``@registry.before_tools``, or ``@registry.after_tools``.  Then apply
+    them to a ``StateGraph`` builder with ``registry.apply_to_graph(builder)``.
+
+    Example::
+
+        registry = MiddlewareRegistry()
+
+        @registry.before_tools
+        def log_tools(state, tool_name, tool_args):
+            logger.info("About to call %s", tool_name)
+            return state
+
+        @registry.wrap_model_call
+        def track_model(state, model_name, usage):
+            ...
+            return state
+
+        builder = StateGraph(State)
+        ...
+        registry.apply_to_graph(builder)
+        graph = builder.compile()
+    """
+
+    def __init__(self) -> None:
+        self._before_agent: list[Callable[[dict[str, Any]], dict[str, Any]]] = []
+        self._wrap_model_call: list[
+            Callable[[dict[str, Any], str, Any], dict[str, Any]]
+        ] = []
+        self._before_tools: list[
+            Callable[[dict[str, Any], str, Any], dict[str, Any]]
+        ] = []
+        self._after_tools: list[
+            Callable[[dict[str, Any], str, Any, Any], dict[str, Any]]
+        ] = []
+
+    # ------------------------------------------------------------------
+    # Decorators
+    # ------------------------------------------------------------------
+
+    def before_agent(
+        self, fn: Callable[[dict[str, Any]], dict[str, Any]]
+    ) -> Callable[[dict[str, Any]], dict[str, Any]]:
+        """Register a hook that runs before the agent node."""
+        self._before_agent.append(fn)
+        return fn
+
+    def wrap_model_call(
+        self,
+        fn: Callable[[dict[str, Any], str, Any], dict[str, Any]],
+    ) -> Callable[[dict[str, Any], str, Any], dict[str, Any]]:
+        """Register a hook that wraps around the LLM model call.
+
+        Signature: ``fn(state, model_name, usage_estimate) -> state``
+        """
+        self._wrap_model_call.append(fn)
+        return fn
+
+    def before_tools(
+        self,
+        fn: Callable[[dict[str, Any], str, Any], dict[str, Any]],
+    ) -> Callable[[dict[str, Any], str, Any], dict[str, Any]]:
+        """Register a hook that runs before each tool call.
+
+        Signature: ``fn(state, tool_name, tool_args) -> state``
+        """
+        self._before_tools.append(fn)
+        return fn
+
+    def after_tools(
+        self,
+        fn: Callable[[dict[str, Any], str, Any, Any], dict[str, Any]],
+    ) -> Callable[[dict[str, Any], str, Any, Any], dict[str, Any]]:
+        """Register a hook that runs after each tool call.
+
+        Signature: ``fn(state, tool_name, tool_args, tool_result) -> state``
+        """
+        self._after_tools.append(fn)
+        return fn
+
+    # ------------------------------------------------------------------
+    # Application
+    # ------------------------------------------------------------------
+
+    def apply_to_graph(self, builder: Any) -> None:
+        """Wrap every node in the ``StateGraph`` builder with all registered hooks.
+
+        This mutates the builder in-place by replacing each node's callable
+        with a wrapped version that invokes the hook chain.
+        """
+        # LangGraph exposes nodes via builder.nodes (dict[str, Any])
+        nodes: dict[str, Any] = getattr(builder, "nodes", {})
+        for node_name, node_spec in nodes.items():
+            original: Callable[[dict[str, Any]], dict[str, Any]] = getattr(
+                node_spec, "bound", node_spec
+            )
+            wrapped = self._wrap_node(node_name, original)
+            # Replace the bound callable on the node spec
+            if hasattr(node_spec, "bound"):
+                node_spec.bound = wrapped  # type: ignore[attr-defined]
+            else:
+                # If the builder allows dict replacement, update it directly.
+                # Some StateGraph versions store nodes as dict values.
+                nodes[node_name] = wrapped
+
+    def _wrap_node(
+        self, node_name: str, node_fn: Callable[[dict[str, Any]], dict[str, Any]]
+    ) -> Callable[[dict[str, Any]], dict[str, Any]]:
+        """Wrap a single node with the before_agent / after_tools chain."""
+
+        @functools.wraps(node_fn)
+        def _wrapped(state: dict[str, Any]) -> dict[str, Any]:
+            # before_agent
+            for hook in self._before_agent:
+                state = hook(state)
+
+            # Run the node
+            result = node_fn(state)
+            if result is None:
+                result = {}
+
+            # after_tools (applied to the result state as well)
+            for hook in self._after_tools:
+                result = hook(result, node_name, {}, None)
+
+            return result
+
+        return _wrapped
+
+    def wrap_node(
+        self, node_name: str, node_fn: Callable[[dict[str, Any]], dict[str, Any]]
+    ) -> Callable[[dict[str, Any]], dict[str, Any]]:
+        """Manually wrap a single node function (for one-off use)."""
+        return self._wrap_node(node_name, node_fn)
+
+    def wrap_model_call_fn(
+        self,
+        model_fn: Callable[[dict[str, Any], str, Any], Any],
+    ) -> Callable[[dict[str, Any], str, Any], Any]:
+        """Wrap a model-calling function with all ``wrap_model_call`` hooks."""
+
+        @functools.wraps(model_fn)
+        def _wrapped(state: dict[str, Any], model_name: str, usage: Any) -> Any:
+            for hook in self._wrap_model_call:
+                state = hook(state, model_name, usage)
+            return model_fn(state, model_name, usage)
+
+        return _wrapped
+
+    def wrap_tool_call_fn(
+        self,
+        tool_fn: Callable[..., Any],
+        tool_name: str,
+    ) -> Callable[..., Any]:
+        """Wrap a tool-calling function with ``before_tools`` / ``after_tools``."""
+
+        @functools.wraps(tool_fn)
+        def _wrapped(*args: Any, **kwargs: Any) -> Any:
+            # before_tools
+            state = kwargs.get("state", {})
+            for hook in self._before_tools:
+                state = hook(state, tool_name, {"args": args, "kwargs": kwargs})
+            kwargs["state"] = state
+
+            result = tool_fn(*args, **kwargs)
+
+            # after_tools
+            for hook in self._after_tools:
+                state = hook(state, tool_name, {"args": args, "kwargs": kwargs}, result)
+            kwargs["state"] = state
+
+            return result
+
+        return _wrapped
