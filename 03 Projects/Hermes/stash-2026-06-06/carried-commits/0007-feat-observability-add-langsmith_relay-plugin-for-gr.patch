+"""Tests for the bundled observability/langsmith_relay plugin."""
+
+from __future__ import annotations
+
+import os
+import pytest
+import importlib
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import yaml
+
+from hermes_cli.plugins import PluginManager
+
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+PLUGIN_DIR = REPO_ROOT / "plugins" / "observability" / "langsmith_relay"
+
+
+class _FakeGraph:
+    """Fake LangGraph with an ``invoke`` method."""
+
+    def __init__(self, result: Any = None):
+        self.result = result
+        self.calls: list[tuple] = []
+
+    def invoke(self, inputs: Any, *, config: dict | None = None) -> Any:
+        self.calls.append((inputs, config))
+        return self.result
+
+
+def _fresh_tracer(monkeypatch):
+    """Import a fresh copy of the tracer module and reset its singleton."""
+    sys.modules.pop("plugins.observability.langsmith_relay.tracer", None)
+    tracer = importlib.import_module("plugins.observability.langsmith_relay.tracer")
+    tracer.reset_for_tests()
+    return tracer
+
+
+def test_manifest_fields():
+    data = yaml.safe_load((PLUGIN_DIR / "plugin.yaml").read_text())
+    assert data["name"] == "langsmith_relay"
+    assert data["hooks"] == ["on_session_start"]
+
+
+def test_langsmith_relay_plugin_is_discoverable_as_bundled_plugin(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes_test"))
+
+    manager = PluginManager()
+    manager.discover_and_load()
+
+    loaded = manager._plugins["observability/langsmith_relay"]
+    assert loaded.manifest.name == "langsmith_relay"
+    assert loaded.manifest.source == "bundled"
+    assert not loaded.enabled
+
+
+def test_hermes_langsmith_client_reads_api_key_from_env(monkeypatch):
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "lsk-test-key")
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient.from_hermes_config()
+    assert client.api_key == "lsk-test-key"
+
+
+def test_hermes_langsmith_client_prefers_langsmith_api_key_env(monkeypatch):
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "lsk-test-key")
+    monkeypatch.setenv("LANGSMITH_API_KEY", "lsk-alt-key")
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient.from_hermes_config()
+    assert client.api_key == "lsk-test-key"
+
+
+def test_hermes_langsmith_client_falls_back_to_langsmith_api_key_env(monkeypatch):
+    monkeypatch.delenv("LANGCHAIN_API_KEY", raising=False)
+    monkeypatch.setenv("LANGSMITH_API_KEY", "lsk-alt-key")
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient.from_hermes_config()
+    assert client.api_key == "lsk-alt-key"
+
+
+def test_hermes_langsmith_client_reads_from_config_yaml(monkeypatch, tmp_path):
+    monkeypatch.delenv("LANGCHAIN_API_KEY", raising=False)
+    monkeypatch.delenv("LANGSMITH_API_KEY", raising=False)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    config_path = tmp_path / "config.yaml"
+    config_path.write_text(
+        yaml.safe_dump(
+            {
+                "langsmith": {
+                    "api_key": "cfg-key",
+                    "project": "hermes-prod",
+                    "tenant": "nousresearch",
+                }
+            }
+        )
+    )
+
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient.from_hermes_config()
+    assert client.api_key == "cfg-key"
+    assert client.project == "hermes-prod"
+    assert client.tenant == "nousresearch"
+
+
+def test_hermes_langsmith_client_env_overrides_config(monkeypatch, tmp_path):
+    """Env key takes precedence over config.yaml key."""
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "env-key")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    config_path = tmp_path / "config.yaml"
+    config_path.write_text(
+        yaml.safe_dump({"langsmith": {"api_key": "cfg-key", "project": "x"}})
+    )
+
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient.from_hermes_config()
+    assert client.api_key == "env-key"
+
+
+def test_get_trace_url_returns_none_when_no_api_key(monkeypatch):
+    monkeypatch.delenv("LANGCHAIN_API_KEY", raising=False)
+    monkeypatch.delenv("LANGSMITH_API_KEY", raising=False)
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient(api_key=None)
+    assert client.get_trace_url("thread-1") is None
+
+
+def test_get_trace_url_returns_valid_format(monkeypatch):
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient(
+        api_key="k", project="my-project", tenant="my-tenant"
+    )
+    url = client.get_trace_url("thread-abc")
+    assert url == "https://smith.langchain.com/o/my-tenant/projects/my-project/traces/thread-abc"
+
+
+def test_get_trace_url_uses_project_override(monkeypatch):
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient(
+        api_key="k", project="default", tenant="t"
+    )
+    url = client.get_trace_url("thread-1", project="override")
+    assert url == "https://smith.langchain.com/o/t/projects/override/traces/thread-1"
+
+
+def test_trace_graph_run_without_api_key(monkeypatch):
+    monkeypatch.delenv("LANGCHAIN_API_KEY", raising=False)
+    monkeypatch.delenv("LANGSMITH_API_KEY", raising=False)
+    tracer = _fresh_tracer(monkeypatch)
+    graph = _FakeGraph(result={"answer": 42})
+    result, trace_url = tracer.trace_graph_run(graph, "thread-1", {"q": "hi"})
+    assert result == {"answer": 42}
+    assert trace_url is None
+    assert len(graph.calls) == 1
+    assert graph.calls[0] == ({"q": "hi"}, {"configurable": {"thread_id": "thread-1"}})
+
+
+def test_trace_graph_run_with_api_key(monkeypatch):
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "test-key")
+    tracer = _fresh_tracer(monkeypatch)
+    graph = _FakeGraph(result={"answer": 42})
+    result, trace_url = tracer.trace_graph_run(graph, "thread-1", {"q": "hi"})
+    assert result == {"answer": 42}
+    assert trace_url is not None
+    assert trace_url == "https://smith.langchain.com/o/default/projects/default/traces/thread-1"
+    assert len(graph.calls) == 1
+
+
+def test_trace_graph_run_sets_env_vars_for_tracing(monkeypatch):
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "test-key")
+    tracer = _fresh_tracer(monkeypatch)
+    graph = _FakeGraph(result="ok")
+    tracer.trace_graph_run(graph, "t1", {})
+    # _tracing_env should set the env vars before invoke and restore them
+    # after.  Since we can't easily observe the transient state, we verify
+    # that the graph was invoked at least once.
+    assert len(graph.calls) == 1
+
+
+def test_trace_graph_run_restores_env_vars(monkeypatch):
+    """Ensure _tracing_env does not pollute os.environ after the run."""
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "test-key")
+    monkeypatch.setenv("LANGCHAIN_TRACING_V2", "false")
+    monkeypatch.setenv("LANGCHAIN_PROJECT", "old-project")
+    tracer = _fresh_tracer(monkeypatch)
+    graph = _FakeGraph(result="ok")
+    tracer.trace_graph_run(graph, "t1", {})
+    assert os.environ.get("LANGCHAIN_TRACING_V2") == "false"
+    assert os.environ.get("LANGCHAIN_PROJECT") == "old-project"
+
+
+def test_trace_graph_run_cleans_up_env_when_no_prior_values(monkeypatch):
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "test-key")
+    monkeypatch.delenv("LANGCHAIN_TRACING_V2", raising=False)
+    monkeypatch.delenv("LANGCHAIN_PROJECT", raising=False)
+    tracer = _fresh_tracer(monkeypatch)
+    graph = _FakeGraph(result="ok")
+    tracer.trace_graph_run(graph, "t1", {})
+    assert "LANGCHAIN_TRACING_V2" not in os.environ
+    assert "LANGCHAIN_PROJECT" not in os.environ
+
+
+def test_trace_graph_run_degrades_on_graph_exception(monkeypatch):
+    """If graph.invoke raises, the exception should propagate."""
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "test-key")
+    tracer = _fresh_tracer(monkeypatch)
+
+    class BrokenGraph:
+        def invoke(self, inputs, *, config=None):
+            raise RuntimeError("boom")
+
+    with pytest.raises(RuntimeError, match="boom"):
+        tracer.trace_graph_run(BrokenGraph(), "t1", {})
+
+
+def test_trace_graph_run_retries_on_tracing_env_failure(monkeypatch):
+    """If _tracing_env fails (e.g., bad env), the graph is still run without tracing."""
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "test-key")
+    tracer = _fresh_tracer(monkeypatch)
+    client = tracer.HermesLangSmithClient(api_key="test-key")
+
+    # Force _tracing_env to raise on entry
+    def _broken_tracing_env(project=None):
+        raise RuntimeError("env broken")
+
+    monkeypatch.setattr(client, "_tracing_env", _broken_tracing_env)
+    graph = _FakeGraph(result="fallback")
+    result, trace_url = client.trace_graph_run(graph, "t1", {})
+    assert result == "fallback"
+    assert trace_url is None
+
+
+def test_module_get_trace_url_convenience(monkeypatch):
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "k")
+    tracer = _fresh_tracer(monkeypatch)
+    url = tracer.get_trace_url("thread-1", project="p")
+    assert url == "https://smith.langchain.com/o/default/projects/p/traces/thread-1"
+
+
+def test_module_get_trace_url_none_when_unconfigured(monkeypatch):
+    monkeypatch.delenv("LANGCHAIN_API_KEY", raising=False)
+    monkeypatch.delenv("LANGSMITH_API_KEY", raising=False)
+    tracer = _fresh_tracer(monkeypatch)
+    assert tracer.get_trace_url("thread-1") is None
+
+
+def test_trace_graph_run_uses_config_project_and_tenant(monkeypatch, tmp_path):
+    monkeypatch.setenv("LANGCHAIN_API_KEY", "k")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    config_path = tmp_path / "config.yaml"
+    config_path.write_text(
+        yaml.safe_dump(
+            {"langsmith": {"project": "proj-42", "tenant": "tenant-x"}}
+        )
+    )
+    tracer = _fresh_tracer(monkeypatch)
+    graph = _FakeGraph(result="ok")
+    result, trace_url = tracer.trace_graph_run(graph, "t1", {})
+    assert trace_url == "https://smith.langchain.com/o/tenant-x/projects/proj-42/traces/t1"
