+"""langsmith_relay — optional Hermes plugin for LangSmith observability.
+
+Exposes `trace_graph_run()` and `get_trace_url()` so that every LangGraph
+run can produce a LangSmith trace URL.  The plugin is a no-op at hook
+level; callers import `tracer` directly.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+
+def register(ctx) -> None:
+    ctx.register_hook("on_session_start", on_session_start)
+
+
+def on_session_start(**kwargs: Any) -> None:
+    """No-op at session start — tracing is opt-in per-graph invocation."""
+    pass
