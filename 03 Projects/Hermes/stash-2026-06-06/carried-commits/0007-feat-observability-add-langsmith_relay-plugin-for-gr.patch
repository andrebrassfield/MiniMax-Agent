+"""LangSmith tracer for Hermes graph runs.
+
+Provides `HermesLangSmithClient`, `trace_graph_run()`, and `get_trace_url()`
+so that every LangGraph invocation can return a trace URL.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+import threading
+from typing import Any, Optional, Tuple
+
+from hermes_constants import get_config_path
+
+logger = logging.getLogger(__name__)
+
+_INIT_FAILED = object()
+_LOCK = threading.RLock()
+_CLIENT: "HermesLangSmithClient | object | None" = None
+
+
+def _resolve_api_key() -> Optional[str]:
+    """Read LangSmith API key from environment.
+
+    Priority:
+    1. ``LANGCHAIN_API_KEY`` env var
+    2. ``LANGSMITH_API_KEY`` env var
+    """
+    return os.environ.get("LANGCHAIN_API_KEY") or os.environ.get("LANGSMITH_API_KEY")
+
+
+def _load_config_safe() -> Optional[dict]:
+    """Load Hermes ``config.yaml`` if it exists and is readable."""
+    try:
+        import yaml
+    except Exception:
+        return None
+    path = get_config_path()
+    if not path.exists():
+        return None
+    try:
+        with open(path, encoding="utf-8") as f:
+            data = yaml.safe_load(f)
+        return data if isinstance(data, dict) else None
+    except Exception:
+        return None
+
+
+class HermesLangSmithClient:
+    """Thin wrapper around LangSmith configuration.
+
+    Reads API key from ``config.yaml`` ``langsmith.api_key`` or ``.env``
+    ``LANGCHAIN_API_KEY``.  When no key is present, every method degrades
+    gracefully (returns ``None`` trace URL).
+    """
+
+    def __init__(
+        self,
+        api_key: Optional[str] = None,
+        project: Optional[str] = None,
+        tenant: Optional[str] = None,
+    ) -> None:
+        self.api_key = api_key
+        self.project = project or "default"
+        self.tenant = tenant or "default"
+
+    @classmethod
+    def from_hermes_config(cls) -> HermesLangSmithClient:
+        """Create a client from Hermes config / env."""
+        api_key = _resolve_api_key()
+        project = "default"
+        tenant = "default"
+
+        config = _load_config_safe()
+        if config:
+            langsmith_cfg = config.get("langsmith") or {}
+            if langsmith_cfg:
+                project = langsmith_cfg.get("project", project)
+                tenant = langsmith_cfg.get("tenant", tenant)
+                if not api_key:
+                    api_key = langsmith_cfg.get("api_key")
+
+        return cls(api_key=api_key, project=project, tenant=tenant)
+
+    def get_trace_url(self, thread_id: str, project: Optional[str] = None) -> Optional[str]:
+        """Return a LangSmith trace URL for *thread_id*.
+
+        Returns ``None`` when the API key is missing so that callers can
+        skip the URL entirely.
+        """
+        if not self.api_key:
+            return None
+        project = project or self.project
+        return (
+            f"https://smith.langchain.com/o/{self.tenant}"
+            f"/projects/{project}/traces/{thread_id}"
+        )
+
+    @contextlib.contextmanager
+    def _tracing_env(self, project: Optional[str] = None):
+        """Temporarily set LangSmith tracing env vars around a graph invocation.
+
+        LangChain / LangGraph automatically pick up ``LANGCHAIN_TRACING_V2``
+        and ``LANGCHAIN_API_KEY`` at runtime via the callback system.
+        """
+        if not self.api_key:
+            yield
+            return
+
+        _set = {
+            "LANGCHAIN_TRACING_V2": "true",
+            "LANGCHAIN_API_KEY": self.api_key,
+        }
+        if project or self.project:
+            _set["LANGCHAIN_PROJECT"] = project or self.project
+
+        old: dict[str, Optional[str]] = {}
+        for key, value in _set.items():
+            old[key] = os.environ.get(key)
+            os.environ[key] = value
+
+        try:
+            yield
+        finally:
+            for key, value in old.items():
+                if value is not None:
+                    os.environ[key] = value
+                elif key in os.environ:
+                    del os.environ[key]
+
+    def trace_graph_run(
+        self,
+        graph: Any,
+        thread_id: str,
+        inputs: Any,
+        project: Optional[str] = None,
+    ) -> Tuple[Any, Optional[str]]:
+        """Run a LangGraph graph with LangSmith tracing and return ``(result, trace_url)``.
+
+        If no API key is configured, the graph is run without tracing and
+        the trace URL is ``None``.
+        """
+        if not self.api_key:
+            result = graph.invoke(inputs, config={"configurable": {"thread_id": thread_id}})
+            return result, None
+
+        trace_url = self.get_trace_url(thread_id, project)
+
+        try:
+            with self._tracing_env(project):
+                result = graph.invoke(inputs, config={"configurable": {"thread_id": thread_id}})
+                return result, trace_url
+        except Exception as exc:
+            logger.debug("LangSmith graph run failed: %s", exc, exc_info=True)
+            result = graph.invoke(inputs, config={"configurable": {"thread_id": thread_id}})
+            return result, None
+
+
+def _get_client() -> Optional[HermesLangSmithClient]:
+    """Lazy singleton returning the client, or ``None`` if init failed."""
+    global _CLIENT
+    with _LOCK:
+        if _CLIENT is _INIT_FAILED:
+            return None
+        if isinstance(_CLIENT, HermesLangSmithClient):
+            return _CLIENT
+        try:
+            _CLIENT = HermesLangSmithClient.from_hermes_config()
+        except Exception as exc:
+            logger.debug("LangSmith client init failed: %s", exc, exc_info=True)
+            _CLIENT = _INIT_FAILED
+            return None
+        return _CLIENT
+
+
+def get_trace_url(thread_id: str, project: Optional[str] = None) -> Optional[str]:
+    """Convenience wrapper: return trace URL for *thread_id*.
+
+    Returns ``None`` when LangSmith is not configured.
+    """
+    client = _get_client()
+    if client is None:
+        return None
+    return client.get_trace_url(thread_id, project)
+
+
+def trace_graph_run(
+    graph: Any,
+    thread_id: str,
+    inputs: Any,
+    project: Optional[str] = None,
+) -> Tuple[Any, Optional[str]]:
+    """Convenience wrapper: run *graph* with LangSmith tracing.
+
+    Returns ``(result, trace_url)``.  When LangSmith is not configured,
+    ``trace_url`` is ``None``.
+    """
+    client = _get_client()
+    if client is None:
+        result = graph.invoke(inputs, config={"configurable": {"thread_id": thread_id}})
+        return result, None
+    return client.trace_graph_run(graph, thread_id, inputs, project)
+
+
+def reset_for_tests() -> None:
+    """Reset the singleton client (used by tests)."""
+    global _CLIENT
+    with _LOCK:
+        _CLIENT = None
