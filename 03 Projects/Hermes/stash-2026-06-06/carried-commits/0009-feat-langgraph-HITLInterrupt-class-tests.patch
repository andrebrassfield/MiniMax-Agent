+"""Tests for agent.langgraph.hitl."""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.langgraph.budget import DollarBudget
+from agent.langgraph.hitl import (
+    HITLInterrupt,
+    approve_command,
+    parse_resume_value,
+    reject_command,
+)
+
+
+# ---------------------------------------------------------------------------
+# parse_resume_value
+# ---------------------------------------------------------------------------
+
+class TestParseResumeValue:
+    def test_yes_strings(self) -> None:
+        for val in ("y", "yes", "Y", "YES", "true", "1"):
+            assert parse_resume_value(val) is True
+
+    def test_no_strings(self) -> None:
+        for val in ("n", "no", "N", "NO", "false", "0"):
+            assert parse_resume_value(val) is False
+
+    def test_bool(self) -> None:
+        assert parse_resume_value(True) is True
+        assert parse_resume_value(False) is False
+
+    def test_invalid_raises(self) -> None:
+        with pytest.raises(ValueError, match="Invalid HITL resume value"):
+            parse_resume_value("maybe")
+
+
+# ---------------------------------------------------------------------------
+# approve_command / reject_command
+# ---------------------------------------------------------------------------
+
+class TestCommands:
+    def test_approve_command(self) -> None:
+        cmd = approve_command()
+        assert cmd.resume == "y"
+
+    def test_reject_command(self) -> None:
+        cmd = reject_command()
+        assert cmd.resume == "n"
+
+
+# ---------------------------------------------------------------------------
+# HITLInterrupt
+# ---------------------------------------------------------------------------
+
+class TestHITLInterrupt:
+    def test_maybe_interrupt_does_nothing_when_under_threshold(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        hitl = HITLInterrupt(budget=budget, threshold=0.8)
+
+        with patch.object(budget, "check_threshold", return_value=False):
+            # Should return without calling interrupt
+            hitl.maybe_interrupt("test_action", estimated_cost=0.05)
+
+    def test_maybe_interrupt_calls_interrupt_when_over_threshold(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        hitl = HITLInterrupt(budget=budget, threshold=0.5)
+
+        with patch.object(budget, "check_threshold", return_value=True):
+            with patch("agent.langgraph.hitl.interrupt") as mock_interrupt:
+                hitl.maybe_interrupt("test_action", estimated_cost=0.60)
+                mock_interrupt.assert_called_once()
+                payload = mock_interrupt.call_args[0][0]
+                assert payload["action"] == "test_action"
+                assert payload["estimated_cost"] == 0.60
+
+    def test_wrap_node(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        hitl = HITLInterrupt(budget=budget, threshold=0.5)
+
+        def _node(state: dict[str, Any]) -> dict[str, Any]:
+            return {"result": "ok"}
+
+        wrapped = hitl.wrap_node(_node, node_name="test_node")
+
+        with patch.object(budget, "check_threshold", return_value=True):
+            with patch("agent.langgraph.hitl.interrupt") as mock_interrupt:
+                wrapped({"foo": "bar"})
+                mock_interrupt.assert_called_once()
+                payload = mock_interrupt.call_args[0][0]
+                assert payload["node_name"] == "test_node"
+
+    def test_wrap_node_runs_body_when_under_threshold(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        hitl = HITLInterrupt(budget=budget, threshold=0.8)
+
+        def _node(state: dict[str, Any]) -> dict[str, Any]:
+            return {"result": "ok"}
+
+        wrapped = hitl.wrap_node(_node, node_name="test_node")
+
+        with patch.object(budget, "check_threshold", return_value=False):
+            result = wrapped({"foo": "bar"})
+            assert result == {"result": "ok"}
+
+    def test_wrap_tool(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        hitl = HITLInterrupt(budget=budget, threshold=0.5)
+
+        def _tool(x: int) -> int:
+            return x * 2
+
+        wrapped = hitl.wrap_tool(_tool, tool_name="double")
+
+        with patch.object(budget, "check_threshold", return_value=True):
+            with patch("agent.langgraph.hitl.interrupt") as mock_interrupt:
+                wrapped(5)
+                mock_interrupt.assert_called_once()
+                payload = mock_interrupt.call_args[0][0]
+                assert payload["tool_name"] == "double"
+
+    def test_wrap_tool_runs_body_when_under_threshold(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        hitl = HITLInterrupt(budget=budget, threshold=0.8)
+
+        def _tool(x: int) -> int:
+            return x * 2
+
+        wrapped = hitl.wrap_tool(_tool, tool_name="double")
+
+        with patch.object(budget, "check_threshold", return_value=False):
+            result = wrapped(5)
+            assert result == 10
+
+    def test_payload_includes_extra(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        hitl = HITLInterrupt(budget=budget, threshold=0.5)
+
+        with patch.object(budget, "check_threshold", return_value=True):
+            with patch("agent.langgraph.hitl.interrupt") as mock_interrupt:
+                hitl.maybe_interrupt(
+                    "action",
+                    estimated_cost=0.1,
+                    payload={"custom": "data"},
+                )
+                payload = mock_interrupt.call_args[0][0]
+                assert payload["extra"]["custom"] == "data"
+
