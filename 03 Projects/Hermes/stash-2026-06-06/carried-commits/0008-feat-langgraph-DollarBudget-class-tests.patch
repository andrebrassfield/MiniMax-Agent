+class DollarBudget:
+    """Thread-safe dollar-cost budget for LangGraph workflows.
+
+    Tracks cumulative API spend and raises ``DollarBudgetExceeded`` when
+    the configured limit is reached.  Uses :func:`estimate_usage_cost` from
+    :mod:`agent.usage_pricing` so model-specific pricing is respected.
+
+    Example::
+
+        budget = DollarBudget(limit=Decimal("1.00"))
+        budget.spend("gpt-4o", CanonicalUsage(input_tokens=1000, output_tokens=500))
+        if budget.check_threshold(0.8):
+            ...  # trigger HITL before next expensive call
+    """
+
+    def __init__(self, limit: Decimal | float | str = Decimal("10.00")) -> None:
+        self.limit = Decimal(str(limit))
+        self._spent = _ZERO
+        self._lock = threading.Lock()
+
+    # ------------------------------------------------------------------
+    # Core tracking
+    # ------------------------------------------------------------------
+
+    def spend(
+        self,
+        model_name: str,
+        usage: CanonicalUsage,
+        *,
+        provider: str | None = None,
+        base_url: str | None = None,
+        api_key: str | None = None,
+    ) -> Decimal:
+        """Record a call's cost and add it to the running total.
+
+        Args:
+            model_name: The model identifier (e.g. ``"gpt-4o"``).
+            usage: Normalized token usage.
+            provider: Optional provider slug (e.g. ``"openai"``).
+            base_url: Optional custom base URL.
+            api_key: Optional API key for custom endpoint pricing.
+
+        Returns:
+            The estimated cost of *this* call in USD.
+
+        Raises:
+            DollarBudgetExceeded: If the call would push ``spent`` over ``limit``.
+        """
+        cost = self.estimate_call_cost(
+            model_name, usage, provider=provider, base_url=base_url, api_key=api_key
+        )
+        with self._lock:
+            if self._spent + cost > self.limit:
+                raise DollarBudgetExceeded(
+                    f"Dollar budget exceeded: ${self._spent + cost:.4f} > ${self.limit:.4f}"
+                )
+            self._spent += cost
+        return cost
+
+    def estimate_call_cost(
+        self,
+        model_name: str,
+        usage: CanonicalUsage,
+        *,
+        provider: str | None = None,
+        base_url: str | None = None,
+        api_key: str | None = None,
+    ) -> Decimal:
+        """Estimate the cost of a single call **without** spending budget.
+
+        Returns:
+            The estimated cost in USD (``Decimal``).  Returns ``0`` if pricing is unknown.
+        """
+        result = estimate_usage_cost(
+            model_name,
+            usage,
+            provider=provider,
+            base_url=base_url,
+            api_key=api_key,
+        )
+        if result.amount_usd is None:
+            return _ZERO
+        return result.amount_usd
+
+    # ------------------------------------------------------------------
+    # Threshold helpers
+    # ------------------------------------------------------------------
+
+    def check_threshold(self, ratio: float = 0.8) -> bool:
+        """Return ``True`` if ``spent >= ratio * limit``.
+
+        Used to decide when to inject a HITL pause before the next
+        expensive operation.
+        """
+        with self._lock:
+            return self._spent >= self.limit * Decimal(str(ratio))
+
+    def check_call_against_threshold(
+        self,
+        model_name: str,
+        usage: CanonicalUsage,
+        *,
+        ratio: float = 0.8,
+        provider: str | None = None,
+        base_url: str | None = None,
+        api_key: str | None = None,
+    ) -> bool:
+        """Return ``True`` if the *next* call would push us over the threshold.
+
+        This is useful for pre-flight checks: you can test whether a call
+        should be gated by HITL *before* actually spending budget.
+        """
+        estimated = self.estimate_call_cost(
+            model_name, usage, provider=provider, base_url=base_url, api_key=api_key
+        )
+        with self._lock:
+            return (self._spent + estimated) >= self.limit * Decimal(str(ratio))
+
+    # ------------------------------------------------------------------
+    # Properties
+    # ------------------------------------------------------------------
+
+    @property
+    def spent(self) -> Decimal:
+        """Total spent so far."""
+        with self._lock:
+            return self._spent
+
+    @property
+    def remaining(self) -> Decimal:
+        """Dollars remaining in the budget."""
+        with self._lock:
+            return max(_ZERO, self.limit - self._spent)
+
+    def reset(self) -> None:
+        """Zero the spent counter."""
+        with self._lock:
+            self._spent = _ZERO
+
+
+class DollarBudgetExceeded(Exception):
+    """Raised when a LangGraph execution exceeds its dollar budget."""
+
+    pass
