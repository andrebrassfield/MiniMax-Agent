+"""Tests for agent.langgraph.budget."""
+
+from __future__ import annotations
+
+from concurrent.futures import ThreadPoolExecutor
+from decimal import Decimal
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from agent.langgraph.budget import (
+    DollarBudget,
+    DollarBudgetExceeded,
+    GraphBudget,
+    GraphBudgetExceeded,
+)
+from agent.usage_pricing import CanonicalUsage
+
+
+# ---------------------------------------------------------------------------
+# GraphBudget
+# ---------------------------------------------------------------------------
+
+class TestGraphBudget:
+    def test_consume_tracks_iterations(self) -> None:
+        budget = GraphBudget(max_iterations=5)
+        budget.consume("node_a")
+        budget.consume("node_b")
+        assert budget.iterations == 2
+        assert budget.remaining() == 3
+
+    def test_exceeding_raises(self) -> None:
+        budget = GraphBudget(max_iterations=2)
+        budget.consume()
+        budget.consume()
+        with pytest.raises(GraphBudgetExceeded):
+            budget.consume()
+
+    def test_reset(self) -> None:
+        budget = GraphBudget(max_iterations=3)
+        budget.consume()
+        budget.reset()
+        assert budget.iterations == 0
+        assert budget.remaining() == 3
+
+
+# ---------------------------------------------------------------------------
+# DollarBudget
+# ---------------------------------------------------------------------------
+
+class TestDollarBudget:
+    def test_init_with_decimal(self) -> None:
+        budget = DollarBudget(limit=Decimal("1.00"))
+        assert budget.limit == Decimal("1.00")
+        assert budget.spent == Decimal("0")
+        assert budget.remaining == Decimal("1.00")
+
+    def test_init_with_float(self) -> None:
+        budget = DollarBudget(limit=10.0)
+        assert budget.limit == Decimal("10.0")
+
+    def test_init_with_str(self) -> None:
+        budget = DollarBudget(limit="5.50")
+        assert budget.limit == Decimal("5.50")
+
+    def test_spend_increments_spent(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        with patch.object(
+            budget,
+            "estimate_call_cost",
+            return_value=Decimal("0.25"),
+        ):
+            budget.spend("gpt-4o", CanonicalUsage())
+        assert budget.spent == Decimal("0.25")
+        assert budget.remaining == Decimal("0.75")
+
+    def test_spend_raises_when_over_limit(self) -> None:
+        budget = DollarBudget(limit=0.5)
+        with patch.object(
+            budget,
+            "estimate_call_cost",
+            return_value=Decimal("0.60"),
+        ):
+            with pytest.raises(DollarBudgetExceeded):
+                budget.spend("gpt-4o", CanonicalUsage())
+
+    def test_check_threshold_false_when_under(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        with patch.object(
+            budget,
+            "estimate_call_cost",
+            return_value=Decimal("0.50"),
+        ):
+            budget.spend("gpt-4o", CanonicalUsage())
+        assert budget.check_threshold(0.8) is False
+
+    def test_check_threshold_true_when_over(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        with patch.object(
+            budget,
+            "estimate_call_cost",
+            return_value=Decimal("0.85"),
+        ):
+            budget.spend("gpt-4o", CanonicalUsage())
+        assert budget.check_threshold(0.8) is True
+
+    def test_check_call_against_threshold(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        with patch.object(
+            budget,
+            "estimate_call_cost",
+            return_value=Decimal("0.30"),
+        ):
+            budget.spend("gpt-4o", CanonicalUsage())
+        with patch.object(
+            budget,
+            "estimate_call_cost",
+            return_value=Decimal("0.60"),
+        ):
+            assert budget.check_call_against_threshold(
+                "gpt-4o", CanonicalUsage(), ratio=0.8
+            ) is True
+
+    def test_reset(self) -> None:
+        budget = DollarBudget(limit=1.0)
+        with patch.object(
+            budget,
+            "estimate_call_cost",
+            return_value=Decimal("0.10"),
+        ):
+            budget.spend("gpt-4o", CanonicalUsage())
+        budget.reset()
+        assert budget.spent == Decimal("0")
+
+    def test_estimate_call_cost_returns_zero_for_unknown(self) -> None:
+        budget = DollarBudget()
+        # No monkeypatch needed; unknown model returns unknown cost
+        cost = budget.estimate_call_cost(
+            "totally-unknown-model-xyz",
+            CanonicalUsage(input_tokens=100, output_tokens=50),
+        )
+        assert cost == Decimal("0")
+
+    def test_estimate_call_cost_for_known_model(self) -> None:
+        budget = DollarBudget()
+        cost = budget.estimate_call_cost(
+            "gpt-4o",
+            CanonicalUsage(input_tokens=1_000_000, output_tokens=500_000),
+            provider="openai",
+        )
+        # gpt-4o: $2.50/M input, $10.00/M output
+        # 1M input * 2.50/M = 2.50
+        # 0.5M output * 10.00/M = 5.00
+        assert cost == Decimal("7.50")
+
+    def test_thread_safety(self) -> None:
+        budget = DollarBudget(limit=10.0)
+
+        def _spend() -> None:
+            with patch.object(
+                budget,
+                "estimate_call_cost",
+                return_value=Decimal("0.10"),
+            ):
+                budget.spend("gpt-4o", CanonicalUsage())
+
+        with ThreadPoolExecutor(max_workers=10) as executor:
+            list(executor.submit(_spend) for _ in range(50))
+
+        assert budget.spent == Decimal("5.00")
+
+    def test_estimate_call_cost_integration(self) -> None:
+        """Smoke-test that the real pricing pipeline is wired correctly."""
+        budget = DollarBudget()
+        result = budget.estimate_call_cost(
+            "deepseek-chat",
+            CanonicalUsage(input_tokens=2_000_000, output_tokens=1_000_000),
+            provider="deepseek",
+        )
+        # deepseek-chat: $0.14/M input, $0.28/M output
+        # 2M * 0.14 = 0.28; 1M * 0.28 = 0.28  →  total 0.56
+        assert result == Decimal("0.56")
