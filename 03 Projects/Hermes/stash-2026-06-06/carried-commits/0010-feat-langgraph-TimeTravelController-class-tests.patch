+"""Tests for agent.langgraph.time_travel.TimeTravelController.
+
+All tests mock the underlying ``PostgresSaver`` so no real database is needed.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent.langgraph.time_travel import TimeTravelController
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+@pytest.fixture
+def mock_saver() -> MagicMock:
+    """Return a mock PostgresSaver with pre-seeded checkpoints."""
+    saver = MagicMock()
+    # Simulate two checkpoints
+    saver.list.return_value = [
+        MagicMock(
+            config={"configurable": {"checkpoint_id": "cp-002"}},
+            metadata={"step": 2, "source": "loop", "writes": {"agent": "hello"}},
+            checkpoint={"ts": "2026-06-06T10:00:00", "parent_id": "cp-001"},
+        ),
+        MagicMock(
+            config={"configurable": {"checkpoint_id": "cp-001"}},
+            metadata={"step": 1, "source": "input", "writes": {"input": "hi"}},
+            checkpoint={"ts": "2026-06-06T09:00:00", "parent_id": None},
+        ),
+    ]
+    return saver
+
+
+@pytest.fixture
+def controller(mock_saver: MagicMock) -> TimeTravelController:
+    return TimeTravelController(mock_saver)
+
+
+# ---------------------------------------------------------------------------
+# list_history
+# ---------------------------------------------------------------------------
+
+class TestListHistory:
+    def test_returns_list_of_metadata(self, controller: TimeTravelController, mock_saver: MagicMock) -> None:
+        history = controller.list_history("thread-1")
+        mock_saver.list.assert_called_once()
+        assert len(history) == 2
+        assert history[0]["checkpoint_id"] == "cp-002"
+        assert history[0]["step"] == 2
+        assert history[0]["timestamp"] == "2026-06-06T10:00:00"
+        assert history[0]["parent_checkpoint_id"] == "cp-001"
+
+    def test_empty_list_when_no_checkpoints(self, controller: TimeTravelController, mock_saver: MagicMock) -> None:
+        mock_saver.list.return_value = []
+        history = controller.list_history("thread-1")
+        assert history == []
+
+
+# ---------------------------------------------------------------------------
+# rewind
+# ---------------------------------------------------------------------------
+
+class TestRewind:
+    def test_returns_checkpoint_state(self, controller: TimeTravelController, mock_saver: MagicMock) -> None:
+        mock_saver.get_tuple.return_value = MagicMock(
+            config={"configurable": {"checkpoint_id": "cp-001"}},
+            metadata={"step": 1},
+            checkpoint={"ts": "2026-06-06T09:00:00", "channel_values": {"foo": "bar"}},
+        )
+        state = controller.rewind("thread-1", "cp-001")
+        assert state["channel_values"] == {"foo": "bar"}
+        assert state["metadata"]["step"] == 1
+
+    def test_raises_when_checkpoint_not_found(self, controller: TimeTravelController, mock_saver: MagicMock) -> None:
+        mock_saver.get_tuple.return_value = None
+        with pytest.raises(ValueError, match="Checkpoint 'cp-999' not found"):
+            controller.rewind("thread-1", "cp-999")
+
+
+# ---------------------------------------------------------------------------
+# resume
+# ---------------------------------------------------------------------------
+
+class TestResume:
+    def test_invokes_graph_with_config(self, controller: TimeTravelController) -> None:
+        mock_graph = MagicMock()
+        mock_graph.invoke.return_value = {"result": "ok"}
+
+        result = controller.resume(mock_graph, "thread-1", "cp-001")
+        mock_graph.invoke.assert_called_once()
+        call_args = mock_graph.invoke.call_args
+        assert call_args[1]["config"]["configurable"]["thread_id"] == "thread-1"
+        assert call_args[1]["config"]["configurable"]["checkpoint_id"] == "cp-001"
+        assert result == {"result": "ok"}
+
+    def test_resume_with_input_override(self, controller: TimeTravelController) -> None:
+        mock_graph = MagicMock()
+        mock_graph.invoke.return_value = {"result": "ok"}
+
+        controller.resume(mock_graph, "thread-1", "cp-001", input_override={"foo": "bar"})
+        call_args = mock_graph.invoke.call_args
+        assert call_args[0] == ({"foo": "bar"},)
+
+    def test_resume_latest_when_no_checkpoint_id(self, controller: TimeTravelController) -> None:
+        mock_graph = MagicMock()
+        controller.resume(mock_graph, "thread-1")
+        call_args = mock_graph.invoke.call_args
+        assert "checkpoint_id" not in call_args[1]["config"]["configurable"]
+
+
+# ---------------------------------------------------------------------------
+# get_latest_state
+# ---------------------------------------------------------------------------
+
+class TestGetLatestState:
+    def test_returns_latest(self, controller: TimeTravelController, mock_saver: MagicMock) -> None:
+        mock_saver.get_tuple.return_value = MagicMock(
+            config={"configurable": {"checkpoint_id": "cp-002"}},
+            metadata={"step": 2},
+            checkpoint={"ts": "2026-06-06T10:00:00", "channel_values": {"x": 1}},
+        )
+        state = controller.get_latest_state("thread-1")
+        assert state is not None
+        assert state["channel_values"] == {"x": 1}
+
+    def test_returns_none_when_no_checkpoints(self, controller: TimeTravelController, mock_saver: MagicMock) -> None:
+        mock_saver.get_tuple.return_value = None
+        assert controller.get_latest_state("thread-1") is None
