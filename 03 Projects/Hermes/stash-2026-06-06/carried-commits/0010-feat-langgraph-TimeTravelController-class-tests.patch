+            "metadata": checkpoint_tuple.metadata,
+            "config": checkpoint_tuple.config,
+            "channel_values": checkpoint_tuple.checkpoint.get("channel_values", {})
+            if checkpoint_tuple.checkpoint
+            else {},
+        }
