+    # ------------------------------------------------------------------
+    # Resume
+    # ------------------------------------------------------------------
+
+    def resume(
+        self,
+        graph: Any,
+        thread_id: str,
+        checkpoint_id: str | None = None,
+        *,
+        input_override: dict[str, Any] | None = None,
+    ) -> Any:
+        """Resume graph execution from a checkpoint.
+
+        Args:
+            graph: A compiled LangGraph graph.
+            thread_id: The thread identifier.
+            checkpoint_id: Optional checkpoint to resume from. If ``None``,
+                resumes from the latest checkpoint.
+            input_override: Optional state updates to inject before resuming.
+
+        Returns:
+            The graph invocation result (same shape as ``graph.invoke()``).
+        """
+        config: RunnableConfig = {"configurable": {"thread_id": thread_id}}
+        if checkpoint_id:
+            config["configurable"]["checkpoint_id"] = checkpoint_id
+
+        if input_override:
+            # LangGraph allows passing a dict of state updates as input
+            return graph.invoke(input_override, config=config)
+        return graph.invoke(None, config=config)
+
+    def get_latest_state(self, thread_id: str) -> dict[str, Any] | None:
+        """Return the latest checkpoint state for a thread, or ``None``."""
+        config: RunnableConfig = {"configurable": {"thread_id": thread_id}}
+        checkpoint_tuple = self.saver.get_tuple(config)
+        if checkpoint_tuple is None:
