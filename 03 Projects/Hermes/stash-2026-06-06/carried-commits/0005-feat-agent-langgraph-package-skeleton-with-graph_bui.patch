@@ -0,0 +1,65 @@
+"""LangGraph middleware hooks for Hermes.
+
+Provides lifecycle hooks (pre-node, post-node, pre-graph, post-graph)
+that integrate with Hermes logging, budget, and telemetry.
+"""
+
+from typing import Any
+
+
+class HermesMiddleware:
+    """Middleware adapter that plugs Hermes primitives into LangGraph.
+
+    Hooks:
+    - ``before_node`` / ``after_node`` — log + budget tracking
+    - ``before_graph`` / ``after_graph`` — session setup / teardown
+    """
+
+    def __init__(self, agent: Any | None = None) -> None:
+        self.agent = agent
+
+    def before_node(self, node_name: str, state: dict[str, Any]) -> dict[str, Any]:
+        """Called before a node executes.
+
+        Args:
+            node_name: Name of the node about to run.
+            state: Current graph state.
+
+        Returns:
+            Potentially modified state.
+        """
+        return state
+
+    def after_node(self, node_name: str, state: dict[str, Any]) -> dict[str, Any]:
+        """Called after a node executes.
+
+        Args:
+            node_name: Name of the node that just ran.
+            state: Current graph state.
+
+        Returns:
+            Potentially modified state.
+        """
+        return state
+
+    def before_graph(self, state: dict[str, Any]) -> dict[str, Any]:
+        """Called before the graph starts.
+
+        Args:
+            state: Initial graph state.
+
+        Returns:
+            Potentially modified state.
+        """
+        return state
+
+    def after_graph(self, state: dict[str, Any]) -> dict[str, Any]:
+        """Called after the graph finishes.
+
+        Args:
+            state: Final graph state.
+
+        Returns:
+            Potentially modified state.
+        """
+        return state
