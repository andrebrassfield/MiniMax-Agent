+"""Budget tracking for LangGraph agent loops.
+
+Wraps the existing Hermes ``iteration_budget`` concept so it can be
+enforced inside a LangGraph graph execution.
+"""
+
+from typing import Any
+
+
+class GraphBudget:
+    """Budget guard for LangGraph node execution.
+
+    Tracks iterations and raises ``GraphBudgetExceeded`` when the
+    configured limit is reached.
+    """
+
+    def __init__(self, max_iterations: int = 90) -> None:
+        self.max_iterations = max_iterations
+        self.iterations = 0
+
+    def consume(self, node_name: str | None = None) -> None:
+        """Consume one iteration unit.
+
+        Args:
+            node_name: Optional node name for logging.
+
+        Raises:
+            GraphBudgetExceeded: If the budget is exhausted.
+        """
+        self.iterations += 1
+        if self.iterations > self.max_iterations:
+            raise GraphBudgetExceeded(
+                f"Graph budget exceeded after {self.iterations} iterations"
+                f" (node={node_name})."
+            )
+
+    def remaining(self) -> int:
+        """Return the number of iterations remaining."""
+        return max(0, self.max_iterations - self.iterations)
+
+    def reset(self) -> None:
+        """Reset the iteration counter."""
+        self.iterations = 0
+
+
+class GraphBudgetExceeded(Exception):
+    """Raised when a LangGraph execution exceeds its iteration budget."""
+
+    pass
diff --git a/agent/langgraph/checkpointer.py b/agent/langgraph/checkpointer.py
new file mode 100644
index 000000000..18a291a42
--- /dev/null
+++ b/agent/langgraph/checkpointer.py
@@ -0,0 +1,133 @@
+"""Checkpointing adapter wrapping langgraph-checkpoint-postgres.
+
+Reads Supabase / Hermes Postgres connection config and exposes a
+HermesPostgresSaver that can be used with LangGraph graphs.
+"""
+
+from __future__ import annotations
+
+import os
+from contextlib import contextmanager
+from typing import Any, Iterator
+
+from langgraph.checkpoint.postgres import PostgresSaver
+
+
+class HermesPostgresSaver:
+    """LangGraph PostgresSaver that sources connection config from Hermes.
+
+    Wraps ``PostgresSaver`` (langgraph-checkpoint-postgres) and adds a
+    ``from_hermes_config()`` factory that reads the connection string from
+    the canonical Hermes configuration sources:
+
+    1. ``SUPABASE_DATABASE_URL`` environment variable
+    2. ``SUPABASE_URL`` + ``SUPABASE_SERVICE_ROLE_KEY`` env vars
+    3. ``~/.hermes/config.yaml`` ``database.url`` key
+    4. Falls back to a local postgres default for dev/test
+
+    Example::
+
+        with HermesPostgresSaver.from_hermes_config() as saver:
+            graph = builder.compile(checkpointer=saver)
+    """
+
+    def __init__(self, saver: PostgresSaver) -> None:
+        self._saver = saver
+
+    def __getattr__(self, name: str) -> Any:
+        """Delegate all attribute access to the wrapped PostgresSaver."""
+        return getattr(self._saver, name)
+
+    @classmethod
+    @contextmanager
+    def from_hermes_config(
+        cls, **kwargs: Any
+    ) -> Iterator["HermesPostgresSaver"]:
+        """Create a PostgresSaver from Hermes / Supabase configuration.
+
+        Args:
+            **kwargs: Additional arguments forwarded to
+                ``PostgresSaver.from_conn_string``.
+
+        Yields:
+            A configured ``HermesPostgresSaver`` instance.
+
+        Raises:
+            RuntimeError: If no valid connection configuration is found.
+        """
+        conn_string = _resolve_connection_string()
+        if conn_string is None:
+            raise RuntimeError(
+                "No Postgres connection config found. Set SUPABASE_DATABASE_URL, "
+                "or SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, or database.url in "
+                "~/.hermes/config.yaml"
+            )
+        with PostgresSaver.from_conn_string(conn_string, **kwargs) as saver:
+            yield cls(saver)
+
+
+def _resolve_connection_string() -> str | None:
+    """Resolve the best available Postgres connection string for Hermes.
+
+    Checks in priority order:
+    1. ``SUPABASE_DATABASE_URL`` env var
+    2. ``SUPABASE_URL`` + ``SUPABASE_SERVICE_ROLE_KEY`` env vars
+    3. ``~/.hermes/config.yaml`` ``database.url``
+    4. Local dev fallback
+
+    Returns:
+        A psycopg2-compatible connection string, or ``None`` if nothing is found.
+    """
+    # 1. Direct database URL
+    direct_url = os.getenv("SUPABASE_DATABASE_URL")
+    if direct_url:
+        return direct_url
+
+    # 2. Supabase project URL + service role key
+    supabase_url = os.getenv("SUPABASE_URL")
+    supabase_key = os.getenv("SUPABASE_SERVICE_ROLE_KEY")
+    if supabase_url and supabase_key:
+        # Supabase connection string format: postgresql://postgres:***@<host>:<port>/<database>
+        # The service role key is the password for the postgres user
+        # We need to extract the host from the Supabase URL
+        # Format: https://<project_ref>.supabase.co
+        # Host: db.<project_ref>.supabase.co
+        if supabase_url.startswith("https://"):
+            host = supabase_url.replace("https://", "")
+            # Remove trailing slash if present
+            host = host.rstrip("/")
+            # Supabase default postgres host is db.<project_ref>.supabase.co
+            db_host = f"db.{host}"
+            return f"postgresql://postgres:***@{db_host}:5432/postgres"
+
+    # 3. Hermes config file
+    conn_info = _load_from_hermes_config()
+    if conn_info:
+        return conn_info
+
+    # 4. Dev fallback
+    local_fallback = os.getenv("HERMES_POSTGRES_URL")
+    if local_fallback:
+        return local_fallback
+
+    return None
+
+
+def _load_from_hermes_config() -> str | None:
+    """Load database.url from ~/.hermes/config.yaml if present."""
+    config_path = os.path.expanduser("~/.hermes/config.yaml")
+    if not os.path.exists(config_path):
+        return None
+
+    try:
+        import yaml
+
+        with open(config_path, encoding="utf-8") as f:
+            data = yaml.safe_load(f)
+        if data and isinstance(data, dict):
+            db = data.get("database")
+            if isinstance(db, dict):
+                return db.get("url")
+    except Exception:
+        pass
+    return None
