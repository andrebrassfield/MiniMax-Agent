+"""Human-in-the-loop (HITL) primitives for LangGraph graphs.
+
+Provides interrupt points where a human can review and approve / reject
+agent actions before the graph continues execution.
+"""
+
+from typing import Any
+
+
+class HITLInterrupt(Exception):
+    """Represents a HITL pause point in a LangGraph execution.
+
+    When raised inside a graph node, the graph suspends and waits for
+    human approval before continuing.
+    """
+
+    def __init__(self, message: str, payload: dict[str, Any] | None = None) -> None:
+        self.message = message
+        self.payload = payload or {}
+
+    def __str__(self) -> str:
+        return f"HITLInterrupt: {self.message}"
+
+
+def hitl_approve(node_name: str, payload: dict[str, Any] | None = None) -> None:
+    """Request human approval before continuing past a node.
+
+    Args:
+        node_name: The node that is requesting approval.
+        payload: Serializable data for the human reviewer to inspect.
+
+    Raises:
+        HITLInterrupt: Always, to suspend the graph.
+    """
+    raise HITLInterrupt(
+        message=f"Approval required for node '{node_name}'",
+        payload=payload,
+    )
diff --git a/agent/langgraph/middleware.py b/agent/langgraph/middleware.py
