+"""Time-travel debugging utilities for LangGraph checkpoints.
+
+Provides rewind, replay, and branch inspection helpers that work on top
+of the HermesPostgresSaver checkpoint layer.
+"""
+
+from typing import Any
+
+
+def list_checkpoints(thread_id: str, saver: Any) -> list[dict[str, Any]]:
+    """List all checkpoints for a thread.
+
+    Args:
+        thread_id: The thread identifier.
+        saver: A PostgresSaver-compatible checkpoint instance.
+
+    Returns:
+        A list of checkpoint metadata dicts.
+    """
+    raise NotImplementedError("list_checkpoints() is not yet implemented.")
+
+
+def rewind_to(thread_id: str, checkpoint_id: str, saver: Any) -> dict[str, Any]:
+    """Rewind a thread to a specific checkpoint.
+
+    Args:
+        thread_id: The thread identifier.
+        checkpoint_id: The checkpoint to rewind to.
+        saver: A PostgresSaver-compatible checkpoint instance.
+
+    Returns:
+        The checkpoint state dict.
+    """
+    raise NotImplementedError("rewind_to() is not yet implemented.")
+
+
+def replay(thread_id: str, saver: Any) -> Any:
+    """Replay a thread from its earliest checkpoint.
+
+    Args:
+        thread_id: The thread identifier.
+        saver: A PostgresSaver-compatible checkpoint instance.
+
+    Returns:
+        A generator or iterator over the replayed steps.
+    """
+    raise NotImplementedError("replay() is not yet implemented.")
